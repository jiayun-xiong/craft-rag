# ================================================
# 环境变量配置模板
# 用法：复制本文件为 .env，填入你的真实 key
#   cp .env.example .env
# 注意：.env 已被 .gitignore 忽略，不会上传到 GitHub
# ================================================

# ---- 中科大统一大模型 API（生成用，OpenAI 兼容协议）----
USTC_API_BASE=https://api.llm.ustc.edu.cn/v1
USTC_API_KEY=在这里填入你的中科大API_KEY
# 可选模型：deepseek-v4-flash-ascend1 / qwen3.8-chat / glm-5.3-flash 等
USTC_MODEL=deepseek-v4-flash-ascend1

# ---- 硅基流动 API（Embedding / 重排序用，免费额度，需自行注册）----
# 注册地址：https://cloud.siliconflow.cn
SILICONFLOW_API_BASE=https://api.siliconflow.cn/v1
SILICONFLOW_API_KEY=在这里填入你的硅基流动API_KEY
# Embedding：BAAI/bge-m3 ；重排序：BAAI/bge-reranker-v2-m3
EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
